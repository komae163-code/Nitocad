# --- Owner usage stats -------------------------------------------------
# Set to a long random string to turn on /admin/dashboard and /admin/stats.
# Unset means both routes return 404. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Persistence -------------------------------------------------------
# Path to the sqlite3 database file. On Railway, point this at a mounted
# persistent volume (e.g. /data/nl_to_cad.db) or job/key history is lost
# on every redeploy.
DB_PATH=nl_to_cad.db

# --- Cloudflare R2 (optional but required for production) --------------
# If unset, generated STEP/STL files fall back to being served from local
# disk - fine for local dev, NOT durable on Railway (ephemeral filesystem).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Set this if the bucket is public (custom domain or r2.dev URL) for
# permanent links. If unset, falls back to presigned URLs.
R2_PUBLIC_URL=
R2_PRESIGNED_EXPIRY_SECONDS=604800

# --- DeepSeek (optional - only needed server-side if you want to avoid ---
# --- asking every caller to bring their own key) ------------------------
# The web UI and API also accept a per-request api_key field, so this is
# optional. Current model names (verify against api-docs.deepseek.com):
# deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=

# --- CAD Studio AI tiers -------------------------------------------------
# Basic uses DeepSeek (the key above). Plus lets people pick GPT or Qwen, Advanced is Claude.
# A model shows up as available only when its key AND model name are set.
# The AI only plans the part, the CadQuery templates build it.
OPENAI_API_KEY=
OPENAI_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
# Qwen through Alibaba Cloud's OpenAI-compatible API. Use the base URL for your region:
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Daily AI messages per wallet and what Generate costs in credits (defaults shown):
# Daily AI message limits are off (0 means no limit). Set one above 0 to cap a tier per wallet per 24 hours.
# AI_MESSAGES_PER_DAY_BASIC=0
# AI_MESSAGES_PER_DAY_PLUS=0
# AI_MESSAGES_PER_DAY_ADVANCED=0
# Credits a new Google account starts with (expire after 90 days), and what an AI answer costs.
# EMAIL_SIGNUP_BONUS_CREDITS=250
# CHAT_ANSWER_CREDITS=1
# GENERATE_CREDITS_ENGINE=2   (the "No AI" option: built-in rules, no AI cost, no daily limit)
# GENERATE_CREDITS_BASIC=10
# GENERATE_CREDITS_PLUS=25
# GENERATE_CREDITS_ADVANCED=40

# --- Free preview tier (see POST /preview) -------------------------------
# Hard per-IP limit since nothing else throttles this route the way a
# real BOT payment throttles /generate. Default in config.py is 5/hour;
# only set this if you want a different value.
# RATE_LIMIT_PREVIEW=5/hour

# --- BOT Chain payments (botchain_pay.py, /mcp-bot) ---------------------
# Native-BOT pay-to-treasury flow - see botchain_pay.py's module
# docstring for why this exists instead of an SDK. TREASURY_ADDRESS is
# required for /api/keys/generate, /generate, /export/*, and both
# a2mcp_botchain tools to work at all - unset, they all fail closed with
# a 402 "TREASURY_ADDRESS is not configured" rather than silently
# accepting free calls.
BOTCHAIN_ENVIRONMENT=testnet
TREASURY_ADDRESS=
# Prices and RPC endpoints have working defaults in config.py (testnet:
# chain 968, rpc.bohr.life; mainnet: chain 677, rpc.botchain.ai - the
# mainnet values are corroborated by ShieldGuard's own live
# packages/backend/.env.example, not guessed). Override here only if
# those change.
# BOTCHAIN_KEY_ISSUE_PRICE_BOT=5.0
# BOTCHAIN_PER_CALL_PRICE_BOT=0.2

# --- On-chain design provenance (contracts/DesignRegistry.sol) --------
# DESIGN_REGISTRY_ADDRESS is NOT something you set upfront - run
# scripts/deploy_design_registry.py first, it prints the address to
# paste here after deployment. Leave it unset until then; anchoring is
# silently skipped when it's unset, exports still work fine without it.
DESIGN_REGISTRY_ADDRESS=
# A wallet the SERVER controls, separate from anything a user signs.
# Needs its own small BOT balance for gas (see the deploy script's
# docstring). Never the same purpose as TREASURY_ADDRESS - that one
# only receives, this one signs and spends on gas.
# ANCHOR_WALLET_PRIVATE_KEY is no longer used - each user wallet signs its own anchor tx

# --- File upload and analysis (CAD Studio attach button) -------------------
# Free for now. These limits protect the server and any vision model bill.
# FILE_MAX_UPLOAD_MB=15
# RATE_LIMIT_FILES=30/hour
# FILE_DAILY_LIMIT_PER_ACCOUNT=60
# FILE_ANALYSIS_TIMEOUT_SECONDS=40
# FILE_MAX_IMPORTS_PER_ACCOUNT=40
# FILE_MAX_IMPORT_BYTES=20971520
#
# Reading images and PDF pages needs a vision model. Any provider with an OpenAI
# compatible chat API that accepts images works. Leave VISION_API_KEY empty to switch
# image reading off (STEP/IGES/BREP files and PDF text still work).
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=
# VISION_TIMEOUT_SECONDS=60

# --- Civil calculations (terrain, earthworks, hydraulics, walls) ------------
# RATE_LIMIT_CIVIL=60/minute
# CIVIL_MAX_SURVEY_POINTS=3000


# --- Optional: PCB pack (pcb/) -------------------------------------------------
# kicad-cli is installed by the Dockerfile. Without it boards still build, but
# Gerbers and the real KiCad design-rule check are unavailable.
# KICAD_CLI=kicad-cli
# PCB_FOOTPRINT_DIR=/usr/share/kicad/footprints
# PCB_KICAD_PYTHON=/usr/bin/python3

# --- Optional: STEP / IGES / BREP import worker (file_import.py, cad_worker.py) ---
# The OpenCascade kernel runs in a locked-down subprocess with these limits.
# CAD_WORKER_CONCURRENCY=2
# CAD_WORKER_TIMEOUT_S=60
# CAD_WORKER_MEM_MB=1024
# CAD_QUEUE_WAIT_S=10

# Re-import every STEP export and compare it to the source shape. Set to 0 only if a particular OCCT build trips it on valid parts.
# NITOCAD_STEP_ROUNDTRIP=1

# ---- Bachs (subscriptions and one-time boosts) -------------------------------
# Use the sandbox key while testing. sk_live_ keys switch the code to production.
BACHS_API_KEY=sk_sandbox_replace_me
# Signing secret shown when you add the webhook endpoint in the Bachs dashboard.
BACHS_WEBHOOK_SECRET=replace_me
# Product ids of the two recurring products (Pro 20.00 USD monthly, Max 80.00 USD monthly).
BACHS_PRODUCT_ID_PRO=
BACHS_PRODUCT_ID_MAX=
# Optional. USD per million tokens by model name, as JSON, to log real provider cost per job.
# NITOCAD_PROVIDER_RATES={"your-model-name":{"in":0.0,"out":0.0}}

# Vehicles and machines in the studio chat (vehicle_chat.py). Folder where planned vehicle specs are kept for reuse.
# Default data/spec_library. If the folder cannot be written (serverless hosts), specs are kept in memory only.
# VEHICLE_LIBRARY_DIR=data/spec_library
# VEHICLE_LIBRARY_REVIEW=true   (a thumbs-up or Generate queues a design; run `python spec_library.py pending`, then `approve <id>`)
# VEHICLE_PLAN_TIME_BUDGET_S=120
# VEHICLE_PACKAGE_CACHE_TTL_S=900
