    "width_mm": 24,
    "thickness_mm": "=crank_thk"
   },
   "position": [
    "=crank_len/2",
    "=arm_y",
    0
   ],
   "rotation": [
    -90,
    0,
    0
   ]
  },
  {
   "id": "crank_l",
   "type": "flat_plate",
   "material": "aluminium",
   "parameters": {
    "length_mm": "=crank_len",
    "width_mm": 24,
    "thickness_mm": "=crank_thk"
   },
   "position": [
    "=-crank_len/2",
    "=-arm_y",
