   "default": 17,
   "min": 8,
   "max": 40
  },
  "shell_w": {
   "default": 68,
   "min": 30,
   "max": 130
  },
  "crank_len": {
   "default": 170,
   "min": 80,
   "max": 300
  },
  "crank_thk": {
   "default": 10,
   "min": 3,
   "max": 30
  },
  "ring_teeth": {
   "default": 44,
   "min": 10,
   "max": 80,
   "kind": "int"
  },
  "bearing_w": {
   "default": 10,
   "min": 3,
   "max": 30
  }
 },
 "derived": {
