   "type": "bearing",
   "material": "steel",
   "mirror": "y",
   "parameters": {
    "inner_diameter_mm": "=spindle_dia",
    "outer_diameter_mm": "=spindle_dia*1.9",
    "width_mm": "=bearing_w"
   },
   "position": [
    0,
    "=brg_y",
    0
   ],
   "rotation": [
    -90,
    0,
    0
   ]
  },
  {
   "id": "chainring",
   "type": "sprocket",
   "material": "steel",
   "parameters": {
    "teeth": "=ring_teeth",
    "chain_pitch_mm": 12.7,
    "thickness_mm": 2,
    "bore_diameter_mm": "=spindle_dia"
   },
   "position": [
    0,
    "=arm_y - 12",
    0
   ],
   "rotation": [
    -90,
    0,
    0
   ]
  },
  {
   "id": "crank_r",
