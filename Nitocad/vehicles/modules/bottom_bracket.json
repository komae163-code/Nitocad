   ],
   "rotation": [
    -90,
    0,
    0
   ]
  }
 ],
 "checks": [
  {
   "name": "bearing_outside_spindle",
   "expr": "=spindle_dia*1.9 < shell_w",
   "message": "bearing too wide for the shell"
  },
  {
   "name": "crank_longer_than_ring",
   "expr": "=crank_len > ring_teeth*12.7/(2*pi)",
   "message": "chainring radius exceeds the crank length"
  }
 ]
}