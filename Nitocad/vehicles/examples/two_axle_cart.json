   "default": 60,
   "min": 20,
   "max": 300
  },
  "wheel_dia": 30,
  "base": 120
 },
 "components": [
  {
   "id": "deck",
   "type": "flat_plate",
   "fixed": true,
   "parameters": {
    "length_mm": "=base",
    "width_mm": "=track",
