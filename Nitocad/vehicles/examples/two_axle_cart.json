   },
   "position": [
    0,
    0,
    "=wheel_dia"
   ]
  },
  {
   "id": "axle",
   "type": "shaft",
   "parameters": {
    "diameter_mm": 6,
    "length_mm": "=track + 10"
   },
   "repeat": {
