    "step": [
     "=base - 20",
     0,
     0
    ]
   },
   "position": [
    "=-(base-20)/2",
    0,
    "=wheel_dia/2"
   ],
   "rotation": [
    90,
    0,
    0
   ]
  }
 ]
}