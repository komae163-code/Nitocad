{
 "name": "bicycle",
 "notes": "Concept layout. Stays and forks sit in one plane at fixed offsets, and there is no chain, derailleur, brakes or spokes.",
 "params": {
  "wheel_dia": {
   "default": 680,
   "min": 300,
   "max": 760
  },
  "tyre_w": {
   "default": 28,
   "min": 18,
   "max": 80
  },
  "tube_od": {
   "default": 28,
   "min": 18,
   "max": 45
  },
  "tube_wall": {
   "default": 1.5,
   "min": 0.8,
   "max": 4
  },
  "bb_drop": {
   "default": 70,
   "min": 40,
   "max": 100
  },
  "chainstay": {
   "default": 425,
   "min": 350,
   "max": 500
  },
  "seat_len": {
   "default": 540,
   "min": 380,
   "max": 700
  },
  "seat_angle": {
   "default": 73,
   "min": 65,
   "max": 80
  },
  "head_angle": {
   "default": 72,
   "min": 65,
   "max": 80
  },
  "reach": {
   "default": 390,
   "min": 300,
   "max": 480
  },
  "stack": {
   "default": 560,
   "min": 450,
   "max": 680
  },
  "head_len": {
   "default": 130,
   "min": 90,
   "max": 200
  },
  "crank_len": {
   "default": 170,
   "min": 150,
   "max": 185
  },
  "ring_teeth": {
   "default": 44,
   "min": 28,
   "max": 60,
   "kind": "int"
  }
 },
 "derived": {
  "wheel_r": "=wheel_dia/2",
  "bb_z": "=wheel_r - bb_drop",
  "rear_x": "=-sqrt(chainstay**2 - bb_drop**2)",
  "sa": "=radians(seat_angle)",
  "st_top_x": "=-seat_len*cos(sa)",
  "st_top_z": "=bb_z + seat_len*sin(sa)",
  "st_x2": "=-(seat_len-50)*cos(sa)",
  "st_z2": "=bb_z + (seat_len-50)*sin(sa)",
  "ha": "=radians(head_angle)",
  "ht_top_x": "=reach",
  "ht_top_z": "=bb_z + stack",
  "ht_bot_x": "=ht_top_x + head_len*cos(ha)",
  "ht_bot_z": "=ht_top_z - head_len*sin(ha)",
  "fork_len": "=(ht_bot_z - wheel_r)/sin(ha)",
  "front_x": "=ht_bot_x + fork_len*cos(ha)",
  "wheelbase": "=front_x - rear_x",
  "bar_x": "=ht_top_x + 60",
  "bar_z": "=ht_top_z + 40",
  "post_x": "=st_top_x - 100*cos(sa)",
  "post_z": "=st_top_z + 100*sin(sa)"
 },
 "components": [
  {
   "id": "seat_tube",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     0,
     0,
     "=bb_z"
    ],
    [
     "=st_top_x",
     0,
     "=st_top_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   }
  },
  {
   "id": "top_tube",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=st_x2",
     0,
     "=st_z2"
    ],
    [
     "=ht_top_x",
     0,
     "=ht_top_z - 10"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   }
  },
  {
   "id": "down_tube",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     0,
     0,
     "=bb_z"
    ],
    [
     "=ht_bot_x",
     0,
     "=ht_bot_z + 15"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   }
  },
  {
   "id": "head_tube",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=ht_top_x",
     0,
     "=ht_top_z"
    ],
    [
     "=ht_bot_x",
     0,
     "=ht_bot_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 34,
    "wall_thickness_mm": 2
   }
  },
  {
   "id": "chainstay",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     0,
     65,
     "=bb_z"
    ],
    [
     "=rear_x",
     65,
     "=wheel_r"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 20,
    "wall_thickness_mm": 1.5
   },
   "mirror": "y"
  },
  {
   "id": "seatstay",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=st_x2",
     65,
     "=st_z2"
    ],
    [
     "=rear_x",
     65,
     "=wheel_r"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 16,
    "wall_thickness_mm": 1.2
   },
   "mirror": "y"
  },
  {
   "id": "fork_leg",
   "type": "tube",
   "assembly": "steering",
   "material": "steel",
   "between": [
    [
     "=ht_bot_x",
     50,
     "=ht_bot_z"
    ],
    [
     "=front_x",
     50,
     "=wheel_r"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 26,
    "wall_thickness_mm": 1.5
   },
   "mirror": "y"
  },
  {
   "id": "stem",
   "type": "tube",
   "assembly": "steering",
   "material": "steel",
   "between": [
    [
     "=ht_top_x",
     0,
     "=ht_top_z"
    ],
    [
     "=bar_x",
     0,
     "=bar_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 25,
    "wall_thickness_mm": 2
   }
  },
  {
   "id": "handlebar",
   "type": "tube",
   "assembly": "steering",
   "material": "steel",
   "between": [
    [
     "=bar_x",
     -210,
     "=bar_z"
    ],
    [
     "=bar_x",
     210,
     "=bar_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 22,
    "wall_thickness_mm": 2
   }
  },
  {
   "id": "seatpost",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=st_top_x + 60*cos(sa)",
     0,
     "=st_top_z - 60*sin(sa)"
    ],
    [
     "=post_x",
     0,
     "=post_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": 27,
    "wall_thickness_mm": 2
   }
  },
  {
   "id": "saddle",
   "type": "simple_box",
   "assembly": "frame",
   "material": "plastic",
   "parameters": {
    "length_mm": 260,
    "width_mm": 140,
    "height_mm": 40,
    "wall_thickness_mm": 3,
    "hollow": false,
    "has_lid": false
   },
   "position": [
    "=post_x",
    0,
    "=post_z + 20"
   ]
  },
  {
   "id": "front_wheel",
   "module": "wheel_on_axle",
   "assembly": "wheels",
   "position": [
    "=front_x",
    0,
    "=wheel_r"
   ],
   "params": {
    "tyre_dia": "=wheel_dia",
    "rim_dia": "=wheel_dia - 60",
    "tyre_w": "=tyre_w",
    "axle_dia": 9,
    "axle_len": 100,
    "bearing_w": 8
   }
  },
  {
   "id": "rear_wheel",
   "module": "wheel_on_axle",
   "assembly": "wheels",
   "position": [
    "=rear_x",
    0,
    "=wheel_r"
   ],
   "params": {
    "tyre_dia": "=wheel_dia",
    "rim_dia": "=wheel_dia - 60",
    "tyre_w": "=tyre_w",
    "axle_dia": 10,
    "axle_len": 135,
    "bearing_w": 8
   }
  },
  {
   "id": "crankset",
   "module": "bottom_bracket",
   "assembly": "drivetrain",
   "position": [
    0,
    0,
    "=bb_z"
   ],
   "params": {
    "crank_len": "=crank_len",
    "ring_teeth": "=ring_teeth"
   }
  }
 ],
 "checks": [
  {
   "name": "wheelbase_in_range",
   "expr": "=wheelbase >= 900 and wheelbase <= 1200",
   "message": "wheelbase outside 900 to 1200 mm"
  },
  {
   "name": "fork_long_enough",
   "expr": "=fork_len > 300",
   "message": "fork too short"
  },
  {
   "name": "pedal_clearance",
   "expr": "=bb_z > crank_len + 60",
   "message": "cranks would strike the ground at the bottom of the stroke"
  },
  {
   "name": "seat_tube_fits_frame",
   "expr": "=seat_len < stack + 40",
   "message": "seat tube taller than the stack allows"
  }
 ],
 "explode": {
  "directions": {
   "crankset_spindle": [
    0,
    0,
    -1
   ]
  },
  "intended_contact": [
   [
    "down_tube",
    "head_tube"
   ],
   [
    "chainstay_l",
    "seatstay_l"
   ],
   [
    "chainstay_r",
    "seatstay_r"
   ]
  ]
 },
 "dev_notes": "'between' and orientation assumptions UNVERIFIED on real CadQuery."
}