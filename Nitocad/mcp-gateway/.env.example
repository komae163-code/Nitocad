# --- OKX A2MCP payment gating -------------------------------------------
# From registering as an Agent Service Provider (ASP) on OKX AI,
# A2MCP mode. Happens on OKX's side, not in this repo.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Wallet on X Layer (eip155:196) that receives settlement.
PAY_TO_ADDRESS=

# Optional - overrides the default $0.25 per job.
NL_TO_CAD_PRICE=

# --- Backend bridge --------------------------------------------------------
# Your deployed FastAPI backend (web_app.py), NOT this gateway.
NL_TO_CAD_API_BASE=https://your-app.up.railway.app
# A service key generated once via that backend's POST /api/keys/generate,
# used server-to-server by this gateway. Not the same as any key a human
# demo user generates for themselves in the browser.
NL_TO_CAD_SERVICE_KEY=

PORT=8403
