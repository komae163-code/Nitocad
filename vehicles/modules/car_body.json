{
 "description": "Car, van or small truck body as 23 separate thin sheet panels, so it can be pulled apart, weighed and drawn: floor, firewall (with a tunnel hole), two side panels with wheel arches and door openings, four doors, two shoulder decks, roof, windscreen, rear window, two side windows, hood, nose, trunk lid, tail, front and rear fascia and two bumpers. Origin at the centre of the footprint on the ground, front is +X, left is +Y. Give wheelbase, wheel_dia, track and tyre_w the same values as the wheels; the floor gets wheel wells and the firewall stops short of the front tyres. Panels are 2.5 mm steel by default and glass is 4 mm acrylic. Place it once, as an instance named for the body, and add the wheels, engine and interior as separate components.",
 "params": {
  "body_len": {
   "default": 4200,
   "min": 3000,
   "max": 6000
  },
  "body_w": {
   "default": 1780,
   "min": 1300,
   "max": 2300
  },
  "body_h": {
   "default": 1450,
   "min": 1100,
   "max": 2200
  },
  "ground_clr": {
   "default": 150,
   "min": 80,
   "max": 400
  },
  "belt_z": {
   "default": 780,
   "min": 500,
   "max": 1100
  },
  "wheelbase": {
   "default": 2600,
   "min": 1800,
   "max": 4000
  },
  "wheel_dia": {
   "default": 640,
   "min": 400,
   "max": 900
  },
  "rear_bay": {
   "default": 380,
   "min": 300,
   "max": 1200
  },
  "wall": {
   "default": 2.5,
   "min": 1.5,
   "max": 4
  },
  "glass_t": {
   "default": 4,
   "min": 3,
   "max": 8
  },
  "track": {
   "default": 1550,
   "min": 1100,
   "max": 2200
  },
  "tyre_w": {
   "default": 205,
   "min": 125,
   "max": 355
  },
  "tunnel_z": {
   "default": 400,
   "min": 200,
   "max": 900
  },
  "tunnel_d": {
   "default": 80,
   "min": 20,
   "max": 300
  }
 },
 "derived": {
  "hl": "=body_len/2",
  "hw": "=body_w/2",
  "cbf": "=hl - 1100",
  "cbr": "=-hl + rear_bay",
  "rf": "=cbf - 480",
  "rr": "=cbr + 420",
  "cab_hw": "=hw - 110",
  "roof_hw": "=cab_hw - glass_t",
  "fx": "=wheelbase/2",
  "wheel_r": "=wheel_dia/2",
  "arch_dia": "=wheel_dia + 90",
  "nose_x": "=hl - 380",
  "tail_x": "=-hl + 260",
  "nose_drop": "=110",
  "tail_drop": "=70",
  "side_off": "=hw - wall/2",
  "win_off": "=cab_hw - glass_t/2",
  "door_x0": "=20",
  "door_x1": "=fx - arch_dia/2 - 12",
  "door_z0": "=ground_clr + 120",
  "door_z1": "=belt_z - 30",
  "dgap": "=3",
  "wy_in": "=track/2 - tyre_w/2 - 20",
  "pocket_w": "=hw - wall - wy_in",
  "dcx": "=(door_x0 + door_x1)/2",
  "dcz": "=(door_z0 + door_z1)/2",
  "dw": "=door_x1 - door_x0",
  "dh": "=door_z1 - door_z0",
  "inner_w": "=body_w - 2*wall"
 },
