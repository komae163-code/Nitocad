   "module": "wheel_on_axle",
   "assembly": "wheels",
   "params": {
    "tyre_dia": "=wheel_dia",
    "rim_dia": "=wheel_dia*0.5",
    "tyre_w": "=wheel_w",
    "axle_dia": 6,
    "axle_len": "=wheel_w+6",
