{
 "name": "two_axle_cart",
 "notes": "A small four-wheel cart: a deck on two axles, with a tyre, axle and bearing at each wheel. The smallest complete wheeled vehicle.",
 "params": {
  "track": {
   "default": 60,
   "min": 20,
   "max": 300
  },
  "wheel_dia": {
   "default": 30,
   "min": 12,
   "max": 120
  },
  "base": 120,
  "wheel_w": 10
 },
 "components": [
  {
   "id": "deck",
   "type": "flat_plate",
   "fixed": true,
   "assembly": "deck",
   "parameters": {
    "length_mm": "=base",
    "width_mm": "=track",
    "thickness_mm": 4
   },
   "position": [
    0,
    0,
    "=wheel_dia"
   ]
  },
  {
   "id": "wheel_front_left",
   "module": "wheel_on_axle",
   "assembly": "wheels",
   "params": {
    "tyre_dia": "=wheel_dia",
    "rim_dia": "=wheel_dia*0.5",
    "tyre_w": "=wheel_w",
    "axle_dia": 6,
    "axle_len": "=wheel_w+6",
    "bearing_w": 3
   },
   "position": [
    "=(base-20)/2",
    "=(track/2 + wheel_w/2 + 2)",
    "=wheel_dia/2"
   ]
  },
  {
   "id": "wheel_front_right",
