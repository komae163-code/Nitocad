{
 "name": "wheelbarrow",
 "notes": "Concept layout. The tray is a sloped tub, smaller at the bottom than the top. The rails close in toward the front and meet the fork tubes above the wheel, then the handles flare out to the grips and rise toward them. Not load-rated.",
 "params": {
  "tray_len": {
   "default": 800,
   "min": 300,
   "max": 1500
  },
  "tray_w": {
   "default": 560,
   "min": 250,
   "max": 1000
  },
  "tray_h": {
   "default": 280,
   "min": 100,
   "max": 600
  },
  "tray_wall": {
   "default": 2,
   "min": 1,
   "max": 10
  },
  "wheel_dia": {
   "default": 400,
   "min": 200,
   "max": 700
  },
  "tyre_w": {
   "default": 90,
   "min": 30,
   "max": 200
  },
  "tube_od": {
   "default": 25,
   "min": 15,
   "max": 50
  },
  "tube_wall": {
   "default": 2,
   "min": 1,
   "max": 5
  },
  "handle_len": {
   "default": 550,
   "min": 200,
   "max": 1000
  },
  "rail_gap": {
   "default": 440,
   "min": 250,
   "max": 900
  },
  "leg_inset": {
   "default": 120,
   "min": 50,
   "max": 400
  },
  "max_width": {
   "default": 700,
   "min": 300,
   "max": 2000
  },
  "tray_base_len": {
   "default": 560,
   "min": 200,
   "max": 1400
  },
  "tray_base_w": {
   "default": 460,
   "min": 200,
   "max": 950
  },
  "handle_rise": {
   "default": 300,
   "min": 0,
   "max": 600
  },
  "grip_gap": {
   "default": 620,
   "min": 400,
   "max": 900
  }
 },
 "derived": {
  "wheel_r": "=wheel_dia/2",
  "rail_z": "=wheel_dia + 15 + tube_od/2",
  "tray_bottom": "=rail_z + tube_od/2",
  "hy": "=rail_gap/2",
  "wheel_x": "=tray_len/2 - wheel_dia/2 - 20",
  "fork_y": "=tyre_w/2 + 14",
  "axle_len": "=2*(tyre_w/2 + 14) + 2*tube_od",
  "rail_slope": "=(hy - fork_y)/max(wheel_x + tray_len/2, 100)",
  "cross_front_x": "=wheel_x - wheel_r - 40"
 },
 "components": [
  {
   "id": "tray",
   "type": "tapered_tray",
   "assembly": "tray",
   "fixed": true,
   "material": "steel",
   "parameters": {
    "length_mm": "=tray_len",
    "width_mm": "=tray_w",
    "height_mm": "=tray_h",
    "bottom_length_mm": "=tray_base_len",
    "bottom_width_mm": "=tray_base_w",
    "wall_thickness_mm": "=tray_wall"
   },
   "position": [
    0,
    0,
    "=tray_bottom"
   ]
  },
  {
   "id": "rail",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=wheel_x",
     "=fork_y",
     "=rail_z"
    ],
    [
     "=-tray_len/2",
     "=hy",
     "=rail_z"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   },
   "mirror": "y",
   "fixed": true
  },
  {
   "id": "handle",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=-tray_len/2",
     "=hy",
     "=rail_z"
    ],
    [
     "=-tray_len/2 - handle_len",
     "=grip_gap/2",
     "=rail_z + handle_rise"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   },
   "mirror": "y",
   "fixed": true
  },
  {
   "id": "leg",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=-tray_len/2 + leg_inset",
     "=hy - rail_slope*leg_inset",
     0
    ],
    [
     "=-tray_len/2 + leg_inset",
     "=hy - rail_slope*leg_inset",
     "=rail_z - tube_od/2"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   },
   "mirror": "y"
  },
  {
   "id": "cross_front",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=cross_front_x",
     "=-(fork_y + rail_slope*(wheel_x - cross_front_x))",
     "=rail_z - tube_od"
    ],
    [
     "=cross_front_x",
     "=fork_y + rail_slope*(wheel_x - cross_front_x)",
     "=rail_z - tube_od"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   }
  },
  {
   "id": "cross_rear",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=-tray_len/2 + 60",
     "=-(hy - rail_slope*60)",
     "=rail_z - tube_od"
    ],
    [
     "=-tray_len/2 + 60",
     "=hy - rail_slope*60",
     "=rail_z - tube_od"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   }
  },
  {
   "id": "fork",
   "type": "tube",
   "assembly": "frame",
   "material": "steel",
   "between": [
    [
     "=wheel_x",
     "=fork_y",
     "=wheel_r"
    ],
    [
     "=wheel_x",
     "=fork_y",
     "=rail_z - tube_od/2"
    ]
   ],
   "parameters": {
    "outer_diameter_mm": "=tube_od",
    "wall_thickness_mm": "=tube_wall"
   },
   "mirror": "y"
  },
  {
   "id": "front_wheel",
   "module": "wheel_on_axle",
   "assembly": "wheel",
   "position": [
    "=wheel_x",
    0,
    "=wheel_r"
   ],
   "params": {
    "tyre_dia": "=wheel_dia",
    "rim_dia": "=wheel_dia*0.6",
    "tyre_w": "=tyre_w",
    "axle_dia": 12,
    "axle_len": "=axle_len",
    "bearing_w": 10
   }
  }
 ],
 "checks": [
  {
   "name": "fits_through_door",
   "expr": "=max(tray_w, grip_gap + tube_od) <= max_width",
   "message": "wider than max_width"
  },
  {
   "name": "forks_inside_rails",
   "expr": "=fork_y + tube_od/2 < hy - tube_od/2",
   "message": "forks collide with the rails"
  },
  {
   "name": "wheel_under_tray",
   "expr": "=wheel_x - wheel_r >= -tray_len/2 and wheel_x + wheel_r <= tray_len/2",
   "message": "wheel sticks out of the tray footprint"
  },
  {
   "name": "wheel_below_rails",
   "expr": "=wheel_dia + 5 < rail_z - tube_od/2",
   "message": "wheel hits the rails"
  },
  {
   "name": "handles_long_enough",
   "expr": "=handle_len >= 400",
   "message": "handles shorter than 400 mm are hard to push"
  },
  {
   "name": "tray_tapers",
   "expr": "=tray_base_len <= tray_len and tray_base_w <= tray_w",
   "message": "the tray floor is larger than its opening"
  },
  {
   "name": "rails_under_tray_floor",
   "expr": "=rail_gap/2 <= tray_base_w/2",
   "message": "the rails sit outside the tray floor, so the tray would not rest on them"
  },
  {
   "name": "grips_at_a_usable_height",
   "expr": "=rail_z + handle_rise >= 600",
   "message": "grips lower than 600 mm are hard on the back"
  },
  {
   "name": "legs_under_tray",
   "expr": "=leg_inset < tray_len - 100",
   "message": "the legs would stand behind the tray, past the straight rails"
  },
  {
   "name": "rails_close_in",
   "expr": "=hy > fork_y + tube_od",
   "message": "the rails are not wider at the back than at the fork"
  },
  {
   "name": "rails_run_front_to_back",
   "expr": "=wheel_x > -tray_len/2 + 200",
   "message": "the wheel is too far back for the rails to run to it"
  },
  {
   "name": "cross_clear_of_wheel",
   "expr": "=cross_front_x > -tray_len/2 + 120",
   "message": "no room for the front crossbar behind the wheel"
  },
  {
   "name": "grips_wider_than_rails",
   "expr": "=grip_gap/2 >= hy",
   "message": "the grips are narrower than the rails at the back"
  }
 ],
 "explode": {
  "directions": {
   "front_wheel_axle": [
    0,
    0,
    -1
   ],
   "front_wheel_tyre": [
    0,
    1,
    0
   ],
   "front_wheel_bearing_left": [
    0,
    1,
    0
   ],
   "front_wheel_bearing_right": [
    0,
    -1,
    0
   ]
  }
 },
 "dev_notes": "Tubes are placed from their start point (the template extrudes from z=0). That and the slanted orientations are read from the source and not yet confirmed on real CadQuery. Not load-rated."
}