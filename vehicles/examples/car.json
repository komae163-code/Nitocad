 "checks": [
  {
   "name": "wheels_inside_body_width",
   "expr": "=track/2 + tyre_w/2 < body_w/2 + 60",
   "message": "wheels stick out too far past the body"
  },
  {
   "name": "wheelbase_fits_body",
   "expr": "=wheelbase + wheel_dia < body_len",
   "message": "wheels would hang off the ends of the body"
  },
  {
   "name": "rim_inside_tyre",
   "expr": "=rim_dia < wheel_dia - 2*tyre_w*0.25",
   "message": "rim leaves no tyre wall"
  },
  {
   "name": "roof_above_belt",
   "expr": "=body_h > belt_z + 300",
   "message": "not enough height for a cabin"
  },
  {
   "name": "arch_top_below_belt",
   "expr": "=wheel_r + arch_dia/2 < belt_z - 40",
   "message": "wheel arch cuts through the beltline"
  },
  {
   "name": "cabin_slopes_valid",
   "expr": "=roof_front > roof_rear + 300",
   "message": "roof is too short, shorten the slopes or lengthen the body"
  },
  {
   "name": "wheel_in_arch_width",
   "expr": "=tyre_w < arch_w",
   "message": "arch is narrower than the tyre"
  },
  {
   "name": "door_clears_arches",
   "expr": "=door_x1 < front_x - arch_dia/2 and door_x0 > rear_x + arch_dia/2",
   "message": "the door opening runs into a wheel arch"
  },
  {
   "name": "gear_pairs_mesh_on_one_spacing",
   "expr": "=approx(gm*(zi1 + zc1)/2, cs_dist, 0.01) and approx(gm*(zi2 + zc2)/2, cs_dist, 0.01)",
   "message": "both gear pairs must have centre distance equal to the shaft spacing"
  },
  {
   "name": "engine_and_gearbox_ahead_of_cabin",
   "expr": "=eng_x0 - 40 > cab_base_front and gb_x0 + 200 < half_l - 50",
   "message": "the engine and gearbox must sit between the windscreen and the front panel"
  },
  {
   "name": "output_shaft_on_axle_line",
   "expr": "=approx(gb_z - cs_dist, wheel_r, 0.01)",
   "message": "the gearbox output shaft must sit at wheel-centre height so the half shafts run straight"
  },
  {
   "name": "output_shaft_clears_flywheel",
   "expr": "=crank_z - 86 > wheel_r + 15 + 5",
   "message": "the output shaft would hit the engine flywheel"
  },
  {
   "name": "differential_clears_crank",
   "expr": "=wheel_r + 38 < crank_z - 65",
   "message": "the differential housing would hit the crankshaft"
  },
  {
   "name": "half_shaft_reaches_the_wheel",
   "expr": "=hs_len > 100",
   "message": "the half shafts are too short to reach the wheels"
  },
  {
   "name": "gearbox_clears_floor",
   "expr": "=gb_z - cs_dist - 72 > ground_clr + wall",
   "message": "the gearbox case would cut through the floor"
  }
 ]
